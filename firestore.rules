rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isCents(v) {
      return v is int && v >= 0;
    }

    function isIsoDate(v) {
      return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    match /users/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;

      match /accounts/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() between 1 and 60
          && request.resource.data.initialBalance is int;
      }

      match /categories/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.kind in ['income', 'expense'];
      }

      match /transactions/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.kind in ['income', 'expense']
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && isIsoDate(request.resource.data.date)
          && request.resource.data.categoryId is string
          && request.resource.data.accountId is string
          && request.resource.data.paymentMethod in ['pix', 'credit', 'debit', 'cash', 'boleto', 'transfer', 'other'];
      }

      match /incomeEntries/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.source in ['clt', 'pj']
          && request.resource.data.kind in ['salary', 'advance', 'invoice', 'tax']
          && isCents(request.resource.data.grossAmount)
          && isCents(request.resource.data.deductions)
          && request.resource.data.deductions <= request.resource.data.grossAmount
          && isIsoDate(request.resource.data.date);
      }

      match /bills/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.title is string
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && isIsoDate(request.resource.data.dueDate)
          && request.resource.data.status in ['pending', 'paid'];
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
